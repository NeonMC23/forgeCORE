+
+int32_t llama_context::stage_layer_cuda(int32_t layer) {
+    if (layer < 0 || static_cast<uint32_t>(layer) >= model.hparams.n_layer_all) {
+        return -1;
+    }
+    if (has_inflight_execution() || gf_res_prev_active != nullptr) {
+        LLAMA_LOG_ERROR("%s: cannot stage layer %d while a graph is active\n", __func__, layer);
+        return -1;
+    }
+    for (const auto & staged : staged_layers) {
+        if (staged.layer == layer) {
+            return 0;
+        }
+    }
+
+    ggml_backend_buffer_type_t cuda_buft = nullptr;
+    for (const auto & backend : backends) {
+        const ggml_backend_dev_t dev = ggml_backend_get_device(backend.get());
+        if (dev != nullptr && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+            cuda_buft = ggml_backend_get_default_buffer_type(backend.get());
+            break;
+        }
+    }
+    if (cuda_buft == nullptr) {
+        LLAMA_LOG_ERROR("%s: no CUDA backend available for layer staging\n", __func__);
+        return -1;
+    }
+
+    std::vector<const ggml_tensor *> sources;
+    for (const auto & [name, tensor] : model.tensors_by_name) {
+        if (tensor != nullptr && staged_layer_name_matches(name, layer)) {
+            sources.push_back(tensor);
+        }
+    }
+    if (sources.empty()) {
+        LLAMA_LOG_ERROR("%s: no tensors found for layer %d\n", __func__, layer);
+        return -1;
+    }
+
+    const size_t alignment = ggml_backend_buft_get_alignment(cuda_buft);
+    size_t total = 0;
+    for (const ggml_tensor * source : sources) {
+        const size_t alloc = ggml_backend_buft_get_alloc_size(cuda_buft, source);
+        total = (total + alignment - 1) / alignment * alignment;
+        total += alloc;
+    }
+    if (total == 0) {
+        LLAMA_LOG_ERROR("%s: zero staged byte total for layer %d\n", __func__, layer);
+        return -1;
+    }
+
+    const size_t ctx_size = ggml_tensor_overhead() * sources.size() + 4096;
+    ggml_init_params params = {
+        /*.mem_size   =*/ ctx_size,
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context * raw_ctx = ggml_init(params);
+    if (raw_ctx == nullptr) {
+        return -1;
+    }
+    llama_staged_layer staged;
+    staged.layer = layer;
+    staged.ctx.reset(raw_ctx);
+    staged.buf.reset(ggml_backend_buft_alloc_buffer(cuda_buft, total));
+    if (staged.buf == nullptr) {
+        return -1;
+    }
+    ggml_backend_buffer_set_usage(staged.buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    char * base = static_cast<char *>(ggml_backend_buffer_get_base(staged.buf.get()));
+    size_t offset = 0;
+    for (const ggml_tensor * source : sources) {
+        ggml_tensor * copy = ggml_new_tensor(
+                staged.ctx.get(), source->type, ggml_n_dims(source), source->ne);
+        if (copy == nullptr) {
+            return -1;
+        }
+        ggml_set_name(copy, source->name);
+        offset = (offset + alignment - 1) / alignment * alignment;
+        if (ggml_backend_tensor_alloc(staged.buf.get(), copy, base + offset) != GGML_STATUS_SUCCESS) {
+            return -1;
+        }
+        offset += ggml_backend_buft_get_alloc_size(cuda_buft, copy);
+        staged.tensors.push_back(copy);
+        staged.by_name.emplace(source->name, copy);
+    }
+    staged.device_bytes = total;
+    staged_layers.push_back(std::move(staged));
+    return 0;
+}
+
+int32_t llama_context::staged_layer_bytes(int32_t layer, uint64_t * out) const {
+    if (out == nullptr || layer < 0 ||
+        static_cast<uint32_t>(layer) >= model.hparams.n_layer_all) {
+        return -1;
+    }
+    ggml_backend_buffer_type_t cuda_buft = nullptr;
+    for (const auto & backend : backends) {
+        const ggml_backend_dev_t dev = ggml_backend_get_device(backend.get());
+        if (dev != nullptr && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+            cuda_buft = ggml_backend_get_default_buffer_type(backend.get());
+            break;
+        }
+    }
+    if (cuda_buft == nullptr) {
+        return -1;
+    }
+    const size_t alignment = ggml_backend_buft_get_alignment(cuda_buft);
+    size_t total = 0;
+    bool found = false;
+    for (const auto & [name, tensor] : model.tensors_by_name) {
+        if (tensor == nullptr || !staged_layer_name_matches(name, layer)) {
+            continue;
+        }
+        found = true;
+        const size_t alloc = ggml_backend_buft_get_alloc_size(cuda_buft, tensor);
+        total = (total + alignment - 1) / alignment * alignment;
+        total += alloc;
+    }
+    if (!found || total == 0) {
+        return -1;
+    }
+    *out = total;
+    return 0;
+}
+
+int32_t llama_context::staged_layer_info(int32_t layer, llama_staged_layer_info * out) const {
+    if (out == nullptr) {
+        return -1;
+    }
+    for (const auto & staged : staged_layers) {
+        if (staged.layer == layer) {
+            std::memset(out, 0, sizeof(*out));
+            out->layer = layer;
+            out->tensor_count = static_cast<int32_t>(staged.tensors.size());
+            out->device_bytes = staged.device_bytes;
+            out->graph_substitutions = staged.graph_substitutions;
+            return 0;
+        }
+    }
+    return -1;
+}
+
+int32_t llama_context::staged_tensor_count(int32_t layer) const {
+    for (const auto & staged : staged_layers) {
+        if (staged.layer == layer) {
+            return static_cast<int32_t>(staged.tensors.size());
+        }
+    }
+    return -1;
+}
+
+int32_t llama_context::staged_tensor_info(
+        int32_t layer, int32_t index, llama_staged_tensor_info * out) const {
+    if (out == nullptr || index < 0) {
+        return -1;
+    }
+    for (const auto & staged : staged_layers) {
+        if (staged.layer != layer) {
+            continue;
+        }
+        if (index >= static_cast<int32_t>(staged.tensors.size())) {
+            return -1;
+        }
+        const ggml_tensor * tensor = staged.tensors[index];
+        std::memset(out, 0, sizeof(*out));
+        std::snprintf(out->name, sizeof(out->name), "%s", tensor->name);
+        out->device_ptr = reinterpret_cast<uint64_t>(tensor->data);
+        out->bytes = ggml_nbytes(tensor);
+        out->layer = layer;
+        return 0;
+    }
+    return -1;
+}
+
+void llama_context::apply_staged_layers(ggml_cgraph * gf) {
+    if (gf == nullptr || staged_layers.empty()) {
+        return;
+    }
+    for (auto & staged : staged_layers) {
+        for (int32_t i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+            ggml_tensor * node = ggml_graph_node(gf, i);
+            if (node == nullptr) {
+                continue;
+            }
+            for (int32_t s = 0; s < GGML_MAX_SRC; ++s) {
+                ggml_tensor * source = node->src[s];
+                if (source == nullptr) {
+                    continue;
+                }
+                auto it = staged.by_name.find(source->name);
+                if (it != staged.by_name.end()) {
+                    node->src[s] = it->second;
+                    staged.graph_substitutions++;
+                }
+            }
+        }
+    }
+}
