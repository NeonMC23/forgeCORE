+static uint64_t llama_page_size_for_model() {
+#ifndef _WIN32
+    const long page_size = sysconf(_SC_PAGESIZE);
+    if (page_size > 0) {
+        return (uint64_t) page_size;
+    }
+#endif
+    return 4096;
