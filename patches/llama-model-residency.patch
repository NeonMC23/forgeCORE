+static bool llama_tensor_storage_is_file_backed(
+        const llama_model * model, const std::string & name, bool * file_backed) {
+    if (file_backed == nullptr) {
+        return false;
+    }
+    const int32_t count = model->tensor_mapping_count();
+    for (int32_t i = 0; i < count; ++i) {
+        llama_tensor_mapping mapping = {};
+        if (model->tensor_mapping_info(i, &mapping) != 0 || mapping.name == nullptr) {
+            continue;
+        }
+        if (name == mapping.name) {
+            *file_backed = mapping.file_backed != 0;
+            return true;
+        }
+    }
+    return false;
+}
+
+static int32_t llama_model_tensor_storage_buffer_index(
+        const llama_model * model, int32_t target) {
+    std::vector<ggml_backend_buffer_t> buffers;
+    int32_t tensor_index = 0;
+    for (const auto & [name, tensor] : model->tensors_by_name) {
+        GGML_UNUSED(name);
+        if (tensor == nullptr || tensor->buffer == nullptr) {
+            continue;
+        }
+        auto it = std::find(buffers.begin(), buffers.end(), tensor->buffer);
+        if (it == buffers.end()) {
+            buffers.push_back(tensor->buffer);
+            if (tensor_index == target) {
+                return static_cast<int32_t>(buffers.size()) - 1;
+            }
+        } else if (tensor_index == target) {
+            return static_cast<int32_t>(it - buffers.begin());
+        }
+        ++tensor_index;
+    }
+    return -1;
+}
+
+int32_t llama_model_tensor_storage_count(const llama_model * model) {
+    if (model == nullptr) {
+        return -1;
+    }
+    int32_t count = 0;
+    for (const auto & [name, tensor] : model->tensors_by_name) {
+        GGML_UNUSED(name);
+        if (tensor != nullptr && tensor->buffer != nullptr) {
+            ++count;
+        }
+    }
+    return count;
+}
+
+int32_t llama_model_tensor_storage_entry(
+        const llama_model * model, int32_t index, llama_tensor_storage_info * out) {
+    if (model == nullptr || out == nullptr || index < 0) {
+        return -1;
+    }
+    int32_t seen = 0;
+    for (const auto & [name, tensor] : model->tensors_by_name) {
+        if (tensor == nullptr || tensor->buffer == nullptr) {
+            continue;
+        }
+        if (seen != index) {
+            ++seen;
+            continue;
+        }
+        const ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(tensor->buffer);
+        const ggml_backend_dev_t device = ggml_backend_buft_get_device(buft);
+        const char * device_name = device == nullptr ? "" : ggml_backend_dev_name(device);
+        std::snprintf(out->name, sizeof(out->name), "%s", name.c_str());
+        std::snprintf(out->buffer_type, sizeof(out->buffer_type), "%s",
+                ggml_backend_buffer_name(tensor->buffer));
+        std::snprintf(out->device_name, sizeof(out->device_name), "%s",
+                device_name == nullptr ? "" : device_name);
+        std::snprintf(out->type_name, sizeof(out->type_name), "%s",
+                ggml_type_name(tensor->type));
+        int32_t layer = -1;
+        if (std::sscanf(name.c_str(), "blk.%d.", &layer) != 1) {
+            layer = -1;
+        }
+        out->layer = layer;
+        out->buffer_index = llama_model_tensor_storage_buffer_index(model, index);
+        out->is_host = ggml_backend_buffer_is_host(tensor->buffer) ? 1 : 0;
+        bool file_backed = false;
+        llama_tensor_storage_is_file_backed(model, name, &file_backed);
+        out->file_backed = file_backed ? 1 : 0;
+        out->tensor_bytes = ggml_nbytes(tensor);
+        const void * base = ggml_backend_buffer_get_base(tensor->buffer);
+        out->tensor_offset = (base != nullptr && tensor->data != nullptr)
+            ? static_cast<uint64_t>(static_cast<const char *>(tensor->data) -
+                    static_cast<const char *>(base))
+            : UINT64_MAX;
+        out->buffer_bytes = ggml_backend_buffer_get_size(tensor->buffer);
+        return 0;
+    }
+    return -1;
+}
+
+int32_t llama_model_tensor_get_bytes(
+        const llama_model * model, const char * name,
+        uint64_t offset, void * out, size_t size) {
+    if (model == nullptr || name == nullptr || out == nullptr) {
+        return -1;
+    }
+    const ggml_tensor * tensor = model->get_tensor(name);
+    if (tensor == nullptr) {
+        return -1;
+    }
+    const size_t total = ggml_nbytes(tensor);
+    if (offset > total || size > total - static_cast<size_t>(offset)) {
+        return -1;
+    }
+    ggml_backend_tensor_get(tensor, out, static_cast<size_t>(offset), size);
+    return 0;
+}
+
+int32_t llama_model_effective_gpu_layers(const llama_model * model) {
+    if (model == nullptr) {
+        return -1;
+    }
+    int32_t count = 0;
+    const int32_t n_layer_all = static_cast<int32_t>(model->hparams.n_layer_all);
+    for (int32_t il = 0; il < n_layer_all; ++il) {
+        const ggml_backend_dev_t dev = model->dev_layer(il);
+        if (dev != nullptr && ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            ++count;
+        }
+    }
+    const ggml_backend_dev_t out = model->dev_output();
+    if (out != nullptr && ggml_backend_dev_type(out) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+        ++count;
+    }
+    return count;
+}
+
+int32_t llama_model_layer_device_type(const llama_model * model, int32_t il) {
+    if (model == nullptr || il < 0 || il >= static_cast<int32_t>(model->hparams.n_layer_all)) {
+        return -1;
+    }
+    const ggml_backend_dev_t dev = model->dev_layer(il);
+    return dev == nullptr ? -1 : static_cast<int32_t>(ggml_backend_dev_type(dev));
+}
