+    // MADV_WILLNEED never removes pages, so it may share the gate with active
+    // inference. It still serializes against an exclusive release.
+    std::shared_lock<std::shared_mutex> lock(pimpl->execution_gate);
+    *out_requested_bytes = 0;
+    const int32_t count = tensor_mapping_count();
+    if (count < 0) {
+        return -1;
+    }
+    std::vector<uint8_t> selected((size_t) count, 0);
+    for (size_t i = 0; i < n_indices; ++i) {
+        if (indices[i] < 0 || indices[i] >= count) {
+            return -1;
+        }
+        selected[(size_t) indices[i]] = 1;
+    }
+
+    std::vector<std::vector<llama_page_interval>> pages(pimpl->mappings.size());
+    for (int32_t index = 0; index < count; ++index) {
+        if (!selected[(size_t) index]) {
+            continue;
+        }
+        llama_tensor_mapping info;
+        if (tensor_mapping_info(index, &info) != 0) {
+            return -1;
+        }
+        if (!info.file_backed) {
+            continue;
+        }
+        const uint64_t first = info.page_start;
+        const uint64_t last  = std::min(info.page_end, info.mapping_size);
+        if (last > first) {
+            pages[(size_t) info.mapping_index].push_back({first, last});
+        }
+    }
+    for (size_t mapping_index = 0; mapping_index < pimpl->mappings.size(); ++mapping_index) {
+        auto & intervals = pages[mapping_index];
+        if (intervals.empty()) {
+            continue;
+        }
+        llama_merge_intervals(intervals);
+        for (const auto & interval : intervals) {
+            const int rc = pimpl->mappings[mapping_index]->prefetch_pages_range(
+                    (size_t) interval.first, (size_t) interval.last);
+            if (rc != 0) {
+                return rc;
+            }
+            *out_requested_bytes += interval.last - interval.first;
+        }
+    }
+    return 0;
+}
+
+int32_t llama_model::tensor_mapping_count() const {
+    if (tensors_by_name.size() > (size_t) INT32_MAX) {
+        return -1;
+    }
+    return (int32_t) tensors_by_name.size();
+}
+
+int32_t llama_model::tensor_mapping_info(int32_t index, llama_tensor_mapping * out) const {
+    if (out == nullptr || index < 0 || (size_t) index >= tensors_by_name.size()) {
+        return -1;
+    }
+    const auto & entry = tensors_by_name[(size_t) index];
+    *out = {};
+    out->name = entry.first.c_str();
+    out->file_backed = 0;
+    out->mapping_index = -1;
+    out->page_size = llama_page_size_for_model();
+    if (entry.second == nullptr || entry.second->data == nullptr) {
+        return 0;
+    }
+    out->size = ggml_nbytes(entry.second);
+    if (out->size == 0) {
+        return 0;
+    }
+    for (size_t mapping_index = 0; mapping_index < pimpl->mappings.size(); ++mapping_index) {
+        size_t offset = 0;
+        if (!pimpl->mappings[mapping_index]->contains_range(entry.second->data, (size_t) out->size, &offset)) {
+            continue;
+        }
+        if (mapping_index > (size_t) INT32_MAX) {
+            return -1;
+        }
+        out->file_backed = 1;
+        out->mapping_index = (int32_t) mapping_index;
+        out->mapping_size = pimpl->mappings[mapping_index]->size();
+        out->offset = offset;
+        const uint64_t page = out->page_size;
+        out->page_start = out->offset & ~(page - 1);
+        if (out->offset > UINT64_MAX - out->size) {
+            return -1;
+        }
+        const uint64_t end = out->offset + out->size;
+        if (end > UINT64_MAX - (page - 1)) {
+            return -1;
+        }
+        out->page_end = (end + page - 1) & ~(page - 1);
+        return 0;
+    }
+    return 0;
+}
+
+int32_t llama_model::release_tensor_pages(const int32_t * indices, size_t n_indices,
+        llama_model_page_release_result * out) {
+    if (out == nullptr || indices == nullptr || n_indices == 0) {
+        return -1;
+    }
+    std::unique_lock<std::shared_mutex> lock(pimpl->execution_gate, std::try_to_lock);
+    if (!lock.owns_lock()) {
+        return EBUSY;
+    }
+    *out = {};
+    const int32_t count = tensor_mapping_count();
+    if (count < 0) {
+        return -1;
+    }
+    std::vector<uint8_t> selected((size_t) count, 0);
+    for (size_t i = 0; i < n_indices; ++i) {
+        if (indices[i] < 0 || indices[i] >= count) {
+            return -1;
+        }
+        selected[(size_t) indices[i]] = 1;
+    }
+
+    std::vector<std::vector<llama_page_interval>> selected_pages(pimpl->mappings.size());
+    std::vector<std::vector<llama_page_interval>> blocked_pages(pimpl->mappings.size());
+    for (int32_t index = 0; index < count; ++index) {
+        llama_tensor_mapping info;
+        if (tensor_mapping_info(index, &info) != 0) {
+            return -1;
+        }
+        const bool is_selected = selected[(size_t) index] != 0;
+        if (!info.file_backed) {
+            if (is_selected) {
+                ++out->non_file_backed_tensors;
+            }
+            continue;
+        }
+        const uint64_t first = info.page_start;
+        const uint64_t last  = std::min(info.page_end, info.mapping_size);
+        if (last <= first) {
+            continue;
+        }
+        if (is_selected) {
+            ++out->selected_tensors;
+            selected_pages[(size_t) info.mapping_index].push_back({first, last});
+        } else {
+            blocked_pages[(size_t) info.mapping_index].push_back({first, last});
+        }
+    }
+
+    for (size_t mapping_index = 0; mapping_index < pimpl->mappings.size(); ++mapping_index) {
+        auto & selected_here = selected_pages[mapping_index];
+        auto & blocked_here = blocked_pages[mapping_index];
+        if (selected_here.empty()) {
+            continue;
+        }
+        llama_merge_intervals(blocked_here);
+        llama_merge_intervals(selected_here);
+        const uint64_t selected_bytes = llama_interval_bytes(selected_here);
+        const auto eligible = llama_subtract_intervals(selected_here, blocked_here);
+        const uint64_t eligible_bytes = llama_interval_bytes(eligible);
+        out->skipped_shared_bytes += selected_bytes - eligible_bytes;
+        for (const auto & interval : eligible) {
+            const int rc = pimpl->mappings[mapping_index]->advise_pages_range(
+                    (size_t) interval.first, (size_t) interval.last);
+            if (rc != 0) {
+                return rc;
+            }
+            out->released_bytes += interval.last - interval.first;
+        }
+    }
+    return 0;
+}
