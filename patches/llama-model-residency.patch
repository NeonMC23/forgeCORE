+int32_t llama_model::sample_mapping_pages(uint64_t mapping_id, uint64_t expected_generation,
+        uint64_t page_start, uint64_t page_end, uint64_t max_pages,
+        llama_page_sample_result * out) const {
+    if (out == nullptr || max_pages == 0 || mapping_id >= pimpl->mappings.size()) {
+        return -1;
+    }
+    uint8_t * page_states = out->page_states;
+    uint64_t * page_offsets = out->page_offsets;
+    const uint64_t state_capacity = out->state_capacity;
+    *out = {};
+    out->page_states = page_states;
+    out->page_offsets = page_offsets;
+    out->state_capacity = state_capacity;
+    out->max_pages = std::min<uint64_t>(max_pages, 4096);
+    out->mapping_id = mapping_id;
+    out->mapping_generation = pimpl->instance_id;
+    if (expected_generation != 0 && expected_generation != pimpl->instance_id) {
+        out->error = ESTALE;
+        return 0;
+    }
+    auto & mapping = pimpl->mappings[(size_t) mapping_id];
+    const uint64_t last = std::min(page_end, mapping->size());
+    if (page_start >= last || page_start % (uint64_t) sysconf(_SC_PAGESIZE) != 0 ||
+            last % (uint64_t) sysconf(_SC_PAGESIZE) != 0) {
+        out->error = EINVAL;
+        return 0;
+    }
+    size_t states_written = 0;
+    const int rc = mapping->sample_pages_range((size_t) page_start, (size_t) last,
+        (size_t) out->max_pages, &out->requested_pages, &out->sampled_pages,
+        &out->resident_pages, &out->nonresident_pages, &out->unknown_pages,
+        &out->failed_pages, &out->page_size, &out->truncated, out->page_states,
+        out->page_offsets, (size_t) out->state_capacity, &states_written);
+    out->states_written = states_written;
+    out->mapping_size = mapping->size();
+    out->page_start = page_start;
+    out->page_end = last;
+    if (rc != 0) {
+        out->error = (uint32_t) rc;
+    } else if (out->requested_pages > 0 && out->sampled_pages == 0) {
