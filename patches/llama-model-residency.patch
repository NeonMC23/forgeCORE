+
+static void llama_merge_intervals(std::vector<llama_page_interval> & intervals) {
+    std::sort(intervals.begin(), intervals.end(), [](const llama_page_interval & a, const llama_page_interval & b) {
+        return a.first < b.first || (a.first == b.first && a.last < b.last);
+    });
+    std::vector<llama_page_interval> merged;
+    for (const auto & interval : intervals) {
+        if (merged.empty() || interval.first > merged.back().last) {
+            merged.push_back(interval);
+        } else if (interval.last > merged.back().last) {
+            merged.back().last = interval.last;
+        }
+    }
+    intervals = std::move(merged);
+}
+
+static uint64_t llama_interval_bytes(const std::vector<llama_page_interval> & intervals) {
+    uint64_t total = 0;
+    for (const auto & interval : intervals) {
+        total += interval.last - interval.first;
+    }
+    return total;
+}
+
+static std::vector<llama_page_interval> llama_subtract_intervals(
+        std::vector<llama_page_interval> selected,
+        const std::vector<llama_page_interval> & blocked) {
+    llama_merge_intervals(selected);
+    std::vector<llama_page_interval> result;
+    size_t blocked_index = 0;
+    for (const auto & interval : selected) {
+        uint64_t cursor = interval.first;
+        while (blocked_index < blocked.size() && blocked[blocked_index].last <= cursor) {
+            ++blocked_index;
+        }
+        size_t index = blocked_index;
+        while (index < blocked.size() && blocked[index].first < interval.last) {
+            const auto & block = blocked[index];
+            const uint64_t first = std::max(cursor, block.first);
+            const uint64_t last  = std::min(interval.last, block.last);
+            if (first > cursor) {
+                result.push_back({cursor, first});
+            }
+            if (last > cursor) {
+                cursor = last;
+            }
+            if (cursor >= interval.last) {
+                break;
+            }
+            ++index;
+        }
+        if (cursor < interval.last) {
+            result.push_back({cursor, interval.last});
+        }
+    }
+    return result;
+}
