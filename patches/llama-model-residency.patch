+int32_t llama_model_lifetime_state(const llama_model * model, struct llama_model_lifetime_state * out) {
+    if (model == nullptr || out == nullptr) {
+        return -1;
+    }
+    *out = {};
+    out->instance_id = model->instance_id();
+    out->active_contexts = model->active_contexts();
+    out->inflight_contexts = model->inflight_contexts();
