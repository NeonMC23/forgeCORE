+uint32_t llama_model_residency_contract_version(void) {
+    return 1;
+}
+
+uint64_t llama_model_instance_id(const llama_model * model) {
+    return model == nullptr ? 0 : model->instance_id();
+}
+
+int32_t llama_model_lifetime_state(const llama_model * model, struct llama_model_lifetime_state * out) {
+    if (model == nullptr || out == nullptr) {
+        return -1;
+    }
+    *out = {};
+    out->instance_id = model->instance_id();
+    out->active_contexts = model->active_contexts();
+    out->inflight_contexts = model->inflight_contexts();
+    std::unique_lock<std::shared_mutex> lock(model->execution_gate(), std::try_to_lock);
+    out->quiescent = lock.owns_lock() ? 1 : 0;
+    return 0;
+}
+
+int32_t llama_model_release_pages(llama_model * model) {
+    if (model == nullptr) {
+        return -1;
+    }
+    return model->release_pages();
+}
+
+int32_t llama_model_tensor_mapping_count(const llama_model * model) {
+    if (model == nullptr) {
+        return -1;
+    }
+    return model->tensor_mapping_count();
+}
+
+int32_t llama_model_tensor_mapping(const llama_model * model, int32_t index,
+        llama_tensor_mapping * out) {
+    if (model == nullptr) {
+        return -1;
+    }
+    return model->tensor_mapping_info(index, out);
+}
+
+int32_t llama_model_release_tensor_pages(llama_model * model, const int32_t * indices,
+        size_t n_indices, llama_model_page_release_result * out) {
+    if (model == nullptr) {
+        return -1;
+    }
+    return model->release_tensor_pages(indices, n_indices, out);
+}
+
+int32_t llama_model_prefetch_tensor_pages(llama_model * model, const int32_t * indices,
+        size_t n_indices, uint64_t * out_requested_bytes) {
+    if (model == nullptr) {
+        return -1;
+    }
+    return model->prefetch_tensor_pages(indices, n_indices, out_requested_bytes);
+}
+
+const char * llama_tensor_op_name(const ggml_tensor * tensor) {
+    if (tensor == nullptr) {
+        return nullptr;
+    }
+    return ggml_op_name(tensor->op);
+}
+
+int32_t llama_tensor_src_count(const ggml_tensor * tensor) {
+    if (tensor == nullptr) {
+        return 0;
+    }
+    int32_t count = 0;
+    for (int i = 0; i < GGML_MAX_SRC; ++i) {
+        if (tensor->src[i] != nullptr) {
+            ++count;
+        }
+    }
+    return count;
+}
+
+const char * llama_tensor_src_name(const ggml_tensor * tensor, int32_t index) {
+    if (tensor == nullptr || index < 0 || index >= GGML_MAX_SRC || tensor->src[index] == nullptr) {
+        return nullptr;
+    }
+    return ggml_get_name(tensor->src[index]);
+}
+
+uint64_t llama_tensor_src_id(const ggml_tensor * tensor, int32_t index) {
+    if (tensor == nullptr || index < 0 || index >= GGML_MAX_SRC || tensor->src[index] == nullptr) {
+        return 0;
+    }
+    return (uint64_t) (uintptr_t) tensor->src[index];
+}
+
 int32_t llama_model_n_ctx_train(const llama_model * model) {
