+int32_t llama_model_memory_breakdown_entry(
+        const llama_model * model, int32_t index, llama_buffer_memory_info * out) {
+    if (model == nullptr || out == nullptr || index < 0) {
+        return -1;
+    }
+    const auto breakdown = model->memory_breakdown();
+    if (index >= static_cast<int32_t>(breakdown.size())) {
+        return -1;
+    }
+    auto it = breakdown.begin();
+    std::advance(it, index);
+    const ggml_backend_buffer_type_t buft = it->first;
+    const char * buffer_name = ggml_backend_buft_name(buft);
+    const ggml_backend_dev_t device = ggml_backend_buft_get_device(buft);
+    const char * device_name = device == nullptr ? "" : ggml_backend_dev_name(device);
+    std::snprintf(out->buffer_type, sizeof(out->buffer_type), "%s",
+            buffer_name == nullptr ? "" : buffer_name);
+    std::snprintf(out->device_name, sizeof(out->device_name), "%s",
+            device_name == nullptr ? "" : device_name);
+    out->model_bytes   = it->second;
+    out->context_bytes = 0;
+    out->compute_bytes = 0;
+    return 0;
+}
