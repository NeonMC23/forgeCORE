diff --git a/src/llama-mmap.cpp b/src/llama-mmap.cpp
index 715a6e3..0c6ccbb 100644
--- a/src/llama-mmap.cpp
+++ b/src/llama-mmap.cpp
@@ -563,6 +563,25 @@ struct llama_mmap::impl {
         mapped_fragments = std::move(new_mapped_fragments);
     }
 
+    int advise_pages() const {
+#ifdef __linux__
+        const size_t page_size = sysconf(_SC_PAGESIZE);
+        for (const auto & frag : mapped_fragments) {
+            const size_t first = frag.first & ~(page_size - 1);
+            const size_t last  = std::min((frag.second + page_size - 1) & ~(page_size - 1), size);
+            if (first >= last) {
+                continue;
+            }
+            if (madvise((char *) addr + first, last - first, MADV_DONTNEED) != 0) {
+                return errno;
+            }
+        }
+        return 0;
+#else
+        return ENOTSUP;
+#endif
+    }
+
     ~impl() {
         for (const auto & frag : mapped_fragments) {
             if (munmap((char *) addr + frag.first, frag.second - frag.first)) {
@@ -672,6 +691,14 @@ void * llama_mmap::addr() const { return pimpl->addr; }
 
 void llama_mmap::unmap_fragment(size_t first, size_t last) { pimpl->unmap_fragment(first, last); }
 
+int llama_mmap::advise_pages() const {
+#if defined(__linux__) && defined(_POSIX_MAPPED_FILES)
+    return pimpl->advise_pages();
+#else
+    return ENOTSUP;
+#endif
+}
